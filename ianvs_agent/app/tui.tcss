Screen {
    background: #0b1220;
    color: #dbe4f0;
}

#topbar {
    height: 3;
    padding: 0 2;
    background: #111c2e;
    border-bottom: solid #27364c;
    align-vertical: middle;
}

#brand { width: 24; text-style: bold; color: #dbeafe; }
#version { width: 14; color: #93c5fd; }
#backend-status { width: 30; height: 2; color: #93c5fd; }
#model-label { width: 6; margin-left: 1; }
#model-select { width: 1fr; height: 3; border: none; }

#workspace { height: 1fr; padding: 1 2 0 2; }
.panel { background: #162235; border: round #304460; padding: 0 1; }
.section-title { height: 2; padding-top: 0; text-style: bold; color: #bfdbfe; }
.field-label { height: 1; color: #94a3b8; }
.muted { color: #94a3b8; height: auto; }
#sidebar { width: 34; margin-right: 1; }
#example-filter { height: 3; border: tall #304460; }
#example-table { height: 1fr; min-height: 4; background: #162235; }
#example-table > .datatable--header { background: #1e304a; color: #94a3b8; }
#example-table > .datatable--cursor { background: #244c7b; color: #eff6ff; }
#instance-select { height: 3; }
#instance-info { height: auto; max-height: 5; color: #94a3b8; margin: 0 0 1 0; }
#sidebar Button { width: 100%; height: 3; margin: 0; }
#main-panel { width: 1fr; }
#main-tabs { height: 1fr; }
TabPane { padding: 0; }
ContentTabs { height: 3; }
RichLog { background: #162235; padding: 0 1; scrollbar-color: #395573; }
#conversation-log { height: 1fr; min-height: 1; }
#stream-response { height: auto; max-height: 8; padding: 0 1; color: #6ee7b7; display: none; }
#run-log { height: 1fr; min-height: 1; }
#run-progress { height: auto; max-height: 4; padding: 0 1; display: none; }
#tool-table { height: 1fr; min-height: 2; background: #162235; }
#tool-table > .datatable--header { background: #1e304a; color: #94a3b8; }
#tool-table > .datatable--cursor { background: #244c7b; color: #eff6ff; }
#tool-details-button { height: 3; width: 100%; margin: 0; }
#input-row { height: 3; margin-top: 1; }
#message-input { width: 1fr; border: tall #304460; }
#send-message { width: 10; min-width: 8; margin-left: 1; }
#summary-panel { height: 10; margin: 1 2 0 2; }
#run-heading { height: 1; }
#run-heading .section-title { width: 20; height: 1; }
#run-status { width: 1fr; text-align: right; color: #fbbf24; }
#activity-row { height: 1; margin-top: 1; }
#activity-indicator { width: 10; height: 1; color: #60a5fa; }
#task-status { width: 1fr; height: 1; color: #bfdbfe; text-overflow: ellipsis; }
#activity-time { width: 13; height: 1; text-align: right; color: #93c5fd; }
#usage-heading { height: 1; }
#usage-row { height: 3; }
.metric { width: 1fr; height: 3; color: #dbeafe; }
#context-bar { height: 1; width: 100%; }
#context-bar Bar { width: 1fr; }
#context-bar Bar > .bar--bar { color: #60a5fa; background: #2b3a50; }
#usage-detail, #verification-detail { height: auto; padding: 1; }
Footer { background: #111c2e; color: #94a3b8; }
Button { border: tall #304460; }
Button:focus { border: tall #60a5fa; }
Input:focus { border: tall #60a5fa; }

.compact-layout #topbar { padding: 0 1; }
.compact-layout #brand { width: 20; }
.compact-layout #version { display: none; }
.compact-layout #backend-status { width: 22; }
.compact-layout #workspace { padding: 0 1; }
.compact-layout #sidebar { width: 28; }
.compact-layout #summary-panel { margin: 1 1 0 1; }
.compact-layout #instance-info { max-height: 3; }
.short-layout #summary-panel { height: 8; }
.short-layout #activity-row { margin-top: 0; }
.short-layout #usage-heading { display: none; }
.short-layout #usage-row { margin-top: 0; height: 2; }
.short-layout .metric { height: 2; }
.short-layout #stream-response { max-height: 4; }
.short-layout #workspace { padding-top: 0; }
.short-layout #sidebar { scrollbar-size: 1 1; }

ApprovalScreen, DeleteInstanceScreen, ExitScreen, ToolDetailsScreen { align: center middle; background: #000000 70%; }
#approval-dialog { width: 80%; max-width: 110; height: 80%; border: round #60a5fa; background: #162235; padding: 1 2; }
#exit-dialog { width: 64; height: auto; border: round #60a5fa; background: #162235; padding: 1 2; }
#delete-instance-dialog { width: 70; max-width: 90%; height: auto; border: round #f87171; background: #162235; padding: 1 2; }
#delete-instance-identity, #delete-instance-description { height: auto; margin-bottom: 1; }
#tool-dialog { width: 90%; max-width: 120; height: 85%; border: round #60a5fa; background: #162235; padding: 1 2; }
#tool-details { height: 1fr; margin-top: 1; }
.dialog-title { height: 2; text-style: bold; color: #bfdbfe; }
#approval-description { height: auto; max-height: 3; margin-bottom: 1; }
#approval-details { height: 1fr; margin: 1 0; border: solid #304460; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
.dialog-actions Button { margin-left: 1; width: auto; }
